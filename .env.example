FRONTEND_DIST_DIR=frontend/dist
PUBLIC_ORIGIN=http://localhost:8000
# CANONICAL_HOST=example.com
PATTERN_CREATION_ENABLED=false
PUBLIC_READ_RATE_LIMIT=120
