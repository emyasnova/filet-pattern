# Local development fallback. Never commit real deployment secrets.
POSTGRES_HOST=localhost
POSTGRES_DB=filet_pattern
POSTGRES_USER=filet
POSTGRES_PASSWORD=filet
POSTGRES_PORT=5432

# Production examples (DATABASE_URL takes priority over POSTGRES_*).
